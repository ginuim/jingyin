    "home.tagline": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频隐私，只留在你的设备里"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片隱私，只留在你的裝置裡"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video privacy, stays on your device"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画のプライバシーは端末内だけに"
          }
        }
      }
    },
