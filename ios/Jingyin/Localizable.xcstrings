    "tracking.lostAt" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tracking was lost near %@. The last coverage position is held afterward."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 付近で追跡対象を見失いました。以降は最後のマスク位置を保持します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "约在 %@ 跟踪丢失；后续暂时保持最后覆盖位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "約在 %@ 追蹤遺失；後續暫時維持最後遮蓋位置。"
          }
        }
      }
    },
    "tracking.waitForCompletion" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wait for face tracking to finish before exporting so an incomplete track is not used."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不完全な追跡結果を使わないよう、顔追跡の完了後に書き出してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请等待人脸跟踪完成后再导出，避免使用不完整的轨迹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請等待人臉追蹤完成後再匯出，避免使用不完整的軌跡。"
          }
        }
      }
    }
