    "editor.pitchHint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真正改变音调，不改变语速；播放时拖动可实时试听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "真正改變音調，不改變語速；播放時拖曳可即時試聽。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes pitch, not speed. Drag while playing to preview."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音程のみ変更（速度はそのまま）。再生中にドラッグで試聴。"
          }
        }
      }
    },
    "quality.detail.fast": {
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "减少主体分析次数，速度优先"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "減少主體分析次數，速度優先"}},
        "en": {"stringUnit": {"state": "translated", "value": "Fewer subject analyses for faster processing"}},
        "ja": {"stringUnit": {"state": "translated", "value": "被写体の解析回数を減らし、速度を優先"}}
      }
    },
    "quality.detail.balanced": {
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "兼顾处理速度和边缘稳定"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "兼顧處理速度與邊緣穩定性"}},
        "en": {"stringUnit": {"state": "translated", "value": "Balances processing speed and stable edges"}},
        "ja": {"stringUnit": {"state": "translated", "value": "処理速度と輪郭の安定性を両立"}}
      }
    },
    "quality.detail.precise": {
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "逐帧分析并细化人物边缘，耗时最长"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "逐幀分析並細化人物邊緣，耗時最長"}},
        "en": {"stringUnit": {"state": "translated", "value": "Analyzes every frame and refines person edges; slowest"}},
        "ja": {"stringUnit": {"state": "translated", "value": "全フレームを解析して人物の輪郭を精細化。最も低速"}}
      }
    },
    "export.title": {
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "导出设置"}},
