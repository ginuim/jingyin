    "export.resolutionHint": {
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "越高越清晰"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "越高越清晰"}},
        "en": {"stringUnit": {"state": "translated", "value": "Higher is sharper"}},
        "ja": {"stringUnit": {"state": "translated", "value": "高いほど鮮明"}}
      }
    },
    "export.frameRate": {
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "帧率"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "幀率"}},
        "en": {"stringUnit": {"state": "translated", "value": "Frame Rate"}},
        "ja": {"stringUnit": {"state": "translated", "value": "フレームレート"}}
      }
    },
    "export.frameRateHint": {
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "越高越流畅"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "越高越流暢"}},
        "en": {"stringUnit": {"state": "translated", "value": "Higher is smoother"}},
        "ja": {"stringUnit": {"state": "translated", "value": "高いほど滑らか"}}
      }
    },
    "export.speedHint": {
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "降低分辨率或帧率，可以明显缩短处理时间。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "降低解析度或幀率，可以明顯縮短處理時間。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Lower resolution or frame rate can significantly reduce processing time."}},
        "ja": {"stringUnit": {"state": "translated", "value": "解像度やフレームレートを下げると、処理時間を大幅に短縮できます。"}}
      }
    },
    "export.reading": {
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在读取视频信息…"}},
