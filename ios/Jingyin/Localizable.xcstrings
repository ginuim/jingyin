    "editor.backgroundEmpty" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose what to keep before continuing."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残す対象を選んでから続けてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请选择要保留的对象，再继续处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請選擇要保留的對象，再繼續處理。"
          }
        }
      }
    },
    "editor.backgroundManualHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In background mode, manual regions keep the original image; the surrounding background receives the effect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景モードでは手動領域の元画像を残し、周囲の背景に効果を適用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景模式下，手动区域保留原画面，其余背景应用效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景模式下，手動區域保留原畫面，其餘背景套用效果。"
          }
        }
      }
    },
    "editor.brushHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paint over the area to cover, then lift your finger. Applies to the whole video by default."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隠したい範囲をなぞり、指を離すと完了します。初期設定では動画全体に適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
