    "tracking.correctionHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move to a clear frame after the loss, reposition or resize the mask, then continue tracking."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見失った後の鮮明なフレームへ移動し、マスクを動かすかサイズを調整してから追跡を再開します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移动到丢失后的清晰画面，拖动或缩放蒙版完成修正，再继续跟踪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移到遺失後的清楚畫面，拖曳或縮放蒙版完成修正，再繼續追蹤。"
          }
        }
      }
    },
