    "editor.pitchHint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真正改变音调，不改变语速；播放时拖动可实时试听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "真正改變音調，不改變語速；播放時拖曳可即時試聽。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes pitch, not speed. Drag while playing to preview."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音程のみ変更（速度はそのまま）。再生中にドラッグで試聴。"
