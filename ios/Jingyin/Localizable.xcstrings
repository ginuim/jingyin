    "editor.animatedHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seek, then adjust the region. Positions are recorded automatically and interpolated. This does not track objects."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生位置を移動して領域を調整すると位置が記録され、記録間を滑らかに移動します。自動追跡ではありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移动播放头，再调整区域；位置自动记录，记录之间平滑移动。不会自动跟随。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動播放頭，再調整區域；位置自動記錄，記錄之間平滑移動。不會自動跟隨。"
          }
        }
      }
    },
