    "editor.manualHelp" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a region to cover missed content. Tap empty space to deselect; delete from the toolbar and undo if needed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "領域を追加して見落としを補正します。余白をタップして選択解除、ツールのゴミ箱で削除できます。取り消しも可能です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加区域补充遗漏内容。点击空白取消选中；垃圾桶删除区域，可撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增區域補充遺漏內容。點擊空白取消選取；垃圾桶刪除區域，可復原。"
          }
        }
      }
    },
    "editor.manualMaskHint" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a mask to adjust it. Moving or resizing remembers its position at the current time. The upper-right close button deletes the entire mask."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マスクをタップして調整します。移動やサイズ変更をすると現在時刻の位置が記録されます。右上の閉じるボタンでマスク全体を削除します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击蒙版进行调整；拖动或缩放会记住当前时间的位置。右上角关闭按钮会删除整个蒙版。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點擊蒙版進行調整；拖曳或縮放會記住目前時間的位置。右上角關閉按鈕會刪除整個蒙版。"
          }
        }
      }
