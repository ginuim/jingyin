{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "brand.name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "镜隐"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鏡隱"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "lenshide"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "lenshide"
          }
        }
      }
    },
    "home.tagline": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频隐私，只留在你的设备里"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片隱私，只留在你的裝置裡"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video privacy, stays on your device"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画のプライバシーは端末内だけに"
          }
        }
      }
    },
    "home.pickPhotos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从相册选择视频"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從相簿選擇影片"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose from Photos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真から動画を選択"
          }
        }
      }
    },
    "home.pickFiles": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从文件选择视频"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從檔案選擇影片"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose from Files"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルから動画を選択"
          }
        }
      }
    },
    "home.privacy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原视频、识别数据和结果均不会上传"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始影片、辨識資料與結果皆不會上傳"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original video, detection data, and results never leave the device"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元動画・検出データ・結果は送信しません"
          }
        }
      }
    },
    "home.reading": {
      "localizations": {
        "zh-Hans": {
