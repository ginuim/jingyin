    "home.privacy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原视频、识别数据和结果均不会上传"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始影片、辨識資料與結果皆不會上傳"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original video, detection data, and results never leave the device"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元動画・検出データ・結果は送信しません"
          }
